{
  "name": "crooli-mc-launcher",
  "productName": "Crooli MC Launcher",
  "version": "0.7.0",
  "description": "A simple, retro-styled Minecraft launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.crooli.launcher",
    "productName": "Crooli MC Launcher",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "artifactName": "Crooli-MC-Launcher-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Crooli-MC-Launcher-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xandertaylorx",
        "repo": "crooli-mc-launcher"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "nsis": {}
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.11",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
