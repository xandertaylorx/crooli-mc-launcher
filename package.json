{
  "name": "crooli-mc-launcher",
  "productName": "Crooli Launcher",
  "version": "0.1.0",
  "description": "A simple, retro-styled Minecraft launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.crooli.launcher",
    "productName": "Crooli Launcher",
    "files": ["src/**/*", "node_modules/**/*", "package.json"],
    "mac": { "target": "dmg", "category": "public.app-category.games" },
    "win": { "target": "nsis" }
  },
  "dependencies": {
    "@fontsource/vt323": "^5.0.0",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
